#!/bin/bash

# Caminho para a pasta contendo os arquivos FASTQ
input_dir="/home/andreiat/Documents/alunos/driii/dataUNICAMP"

# Caminho de saída para os resultados do STAR
output_dir="/home/andreiat/Documents/alunos/driii/dataUNICAMP/mapped"

# Caminho para o genoma indexado
genome_dir="/home/andreiat/Documents/alunos/driii/dataUNICAMP"

# Garante que a pasta de saída exista
mkdir -p ${output_dir}

# Loop sobre todos os arquivos de FASTQ com o padrão _1_val_1.fq.gz
for f in $(ls ${input_dir}/*_1_val_1.fq.gz | sed 's/_1_val_1.fq.gz//' | sort -u)
do
  base_name=$(basename $f) # Nome base do arquivo sem o sufixo

  echo "Processando par: ${base_name}_1_val_1.fq.gz e ${base_name}_2_val_2.fq.gz"
  
  # Executa o STAR para os pares de arquivos de entrada com parâmetros ajustados
  STAR --genomeDir ${genome_dir} \
       --readFilesIn ${input_dir}/${base_name}_1_val_1.fq.gz ${input_dir}/${base_name}_2_val_2.fq.gz \
       --readFilesCommand zcat \
       --outSAMtype BAM SortedByCoordinate \
       --outFileNamePrefix ${output_dir}/${base_name}_ \
       --runThreadN 8 \
       --outFilterMultimapNmax 1 \
       --winAnchorMultimapNmax 50 \
       --outFilterMismatchNmax 2 \
       --alignSJoverhangMin 8 \
       --alignSJDBoverhangMin 5 \
       --alignIntronMin 20 \
       --alignIntronMax 10000 \
       --alignMatesGapMax 10000
done
